---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/tint-check-en/" title="Window tint law check" width="100%" height="720" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free window tint law calculator on your site" description="Put the window tint calculator on your website: one iframe, all 50 states and DC, film times factory glass checked against each statute, no sign-up, no tracking, no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the tint law calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For a driver education site, a car club or a local news page: visitors pick their state, enter their film and glass and see each window checked against the statute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the calculator visible and use it as it is, without warranty. When a state changes its law, the embedded calculator updates itself.</p>
    <p>Nothing your visitors enter reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/tint-check-en/" title="Window tint law check" width="100%" height="720" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
